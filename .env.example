# ChimeraOS / AngieAI environment template
# Copy to .env and fill in real values. NEVER commit the real .env file.
#
# OpenRouter is the shared external-LLM credential used by BOTH:
#   - dmux (optional: AI-generated branch names / commit messages)
#   - AngieAI (fallback reasoning lane when local ONNX/reasoner aren't enough)
#
# Get a key at https://openrouter.ai/ (free / sign-up tier available).
OPENROUTER_API_KEY=

# Local service endpoints (defaults match docker-compose.yml)
ANGIEAI_ONNX_URL=http://localhost:8000
ANGIEAI_REASONER_URL=http://localhost:8001
ANGIEAI_PENTEST_URL=http://localhost:8002

# OpenRouter chat completions endpoint (for reference — used by both
# dmux and AngieAI when calling out to a remote model)
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
